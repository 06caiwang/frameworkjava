<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zyh.adminservice.user.mapper.AppUserMapper">
    <select id="selectByOpenId" parameterType="java.lang.String" resultType="com.zyh.adminservice.user.domain.entity.AppUser">
        select *from app_user where open_id = #{openId}
    </select>

    <select id="selectByMail" parameterType="java.lang.String"  resultType="com.zyh.adminservice.user.domain.entity.AppUser">
        select *from app_user where mail = #{mail}
    </select>
</mapper>